<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="attachment_optimizer_pro_cleanup_confirm_form" model="ir.ui.view">
        <field name="name">attachment.cleanup.confirm.form</field>
        <field name="model">attachment.cleanup.confirm</field>
        <field name="arch" type="xml">
            <form string="Confirm Local Copy Cleanup">
                <div class="alert alert-warning" role="alert">
                    <i class="fa fa-shield"/>
                    Local filestore copies will be removed <strong>only
                    after</strong> SHA-256 checksum verification against the
                    S3 object. Restore from S3 remains possible at any time.
                </div>
                <div class="alert alert-info" role="alert"
                     invisible="count != 0">
                    No selected mappings are eligible. Choose finalized
                    mappings that have completed the retention period.
                </div>                <group>
                    <div class="alert alert-info" role="alert"
                     invisible="count != 0">
                    No selected mappings are eligible. Choose finalized
                    mappings that have completed the retention period.
                </div>                <group>
                        <field name="count"/>
                        <field name="estimated_display"/>
                    </group>
                    <div class="alert alert-info" role="alert"
                     invisible="count != 0">
                    No selected mappings are eligible. Choose finalized
                    mappings that have completed the retention period.
                </div>                <group>
                        <field name="retention_days"/>
                        <field name="quarantine_days"/>
                    </group>
                </group>
                <field name="mapping_ids" nolabel="1">
                    <tree>
                        <field name="attachment_id"/>
                        <field name="cleanup_state" widget="badge"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_confirm" string="Confirm Cleanup"
                            type="object" class="btn-primary" invisible="count == 0"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="attachment_optimizer_pro_cleanup_confirm_action" model="ir.actions.act_window">
        <field name="name">Confirm Local Copy Cleanup</field>
        <field name="res_model">attachment.cleanup.confirm</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
