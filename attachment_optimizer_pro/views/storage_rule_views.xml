<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── List View ─────────────────────────────────────── -->
    <record id="attachment_optimizer_pro_storage_rule_tree" model="ir.ui.view">
        <field name="name">attachment.storage.rule.tree</field>
        <field name="model">attachment.storage.rule</field>
        <field name="arch" type="xml">
            <list create="true" import="true" export_xlsx="true">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="res_model_id"/>
                <field name="mime_type"/>
                <field name="min_size_kb"/>
                <field name="max_size_kb"/>
                <field name="bucket_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────── -->
    <record id="attachment_optimizer_pro_storage_rule_form" model="ir.ui.view">
        <field name="name">attachment.storage.rule.form</field>
        <field name="model">attachment.storage.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="alert"
                         invisible="active">
                        <i class="fa fa-info-circle"/>
                        This rule is inactive and will not route new
                        attachments.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="res_model_id"/>
                            <field name="mime_type"
                                   placeholder="application/pdf"/>
                            <field name="min_size_kb"/>
                            <field name="max_size_kb"/>
                        </group>
                    </group>
                    <group string="Target">
                        <field name="bucket_id"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────── -->
    <record id="attachment_optimizer_pro_storage_rule_action" model="ir.actions.act_window">
        <field name="name">Routing Rules</field>
        <field name="res_model">attachment.storage.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help">
            Routing rules send new binary attachments to a bucket profile
            based on model, MIME type and file size. Rules are evaluated in
            priority order; the first match wins.
        </field>
    </record>
</odoo>
