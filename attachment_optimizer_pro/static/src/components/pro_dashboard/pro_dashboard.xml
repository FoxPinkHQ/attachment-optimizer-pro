<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="attachment_optimizer_pro.SafetyDashboard" owl="1">
        <div class="o_pro_safety_dashboard">
            <div t-if="state.loading" class="o_pro_dashboard_overlay" role="status" aria-live="polite">
                <i class="fa fa-spinner fa-spin fa-3x" aria-hidden="true"/>
                <p>Loading Dashboard…</p>
            </div>
            <div class="o_pro_dashboard_header">
                <div>
                    <h2>Storage Optimization</h2>
                    <p class="text-muted mb-0">Migration overview with Pro cleanup safety, recovery evidence, and savings controls.</p>
                </div>
                <div class="o_pro_dashboard_actions">
                    <button class="btn btn-secondary" type="button"
                            t-on-click="load" t-att-disabled="state.loading"
                            aria-label="Refresh safety and savings dashboard">
                        <i t-att-class="'fa ' + (state.loading ? 'fa-spinner fa-spin' : 'fa-refresh')" aria-hidden="true"/>
                        Refresh
                    </button>
                    <button class="btn btn-primary" type="button"
                            t-on-click="onRunReadiness" t-att-disabled="state.checking"
                            aria-label="Run live cleanup readiness check">
                        <i t-att-class="'fa ' + (state.checking ? 'fa-spinner fa-spin' : 'fa-shield')" aria-hidden="true"/>
                        Run Live Check
                    </button>
                </div>
            </div>

            <div class="o_pro_readiness_banner"
                 t-att-class="state.readiness.ready ? 'o_pro_ready' : 'o_pro_attention'"
                 role="status">
                <i t-att-class="'fa ' + (state.readiness.ready ? 'fa-check-circle' : 'fa-exclamation-triangle')" aria-hidden="true"/>
                <div>
                    <strong t-esc="state.readiness.ready ? 'Ready for safe cleanup' : 'Review cleanup readiness'"/>
                    <div class="small">
                        <t t-if="state.readiness.checked_at">Checked <t t-esc="state.readiness.checked_at"/></t>
                        <t t-else="">Run a live check before enabling automatic cleanup.</t>
                    </div>
                </div>
            </div>

            <div class="o_pro_kpi_grid" aria-label="Storage lifecycle metrics">
                <div class="o_pro_kpi_card">
                    <strong t-esc="state.analytics.total_attachments"/>
                    <span class="o_pro_kpi_label">Stored Attachments</span>
                    <small t-esc="state.analytics.total_display"/>
                </div>
                <div class="o_pro_kpi_card">
                    <strong class="o_pro_value_success" t-esc="state.analytics.migrated"/>
                    <span class="o_pro_kpi_label">Verified S3 Copy</span>
                    <small><t t-esc="state.analytics.migrated_display"/> protected</small>
                </div>
                <button class="o_pro_kpi_card o_pro_kpi_action o_pro_kpi_primary"
                        type="button" t-on-click="onViewReclaimable">
                    <strong t-esc="state.analytics.reclaimable_display"/>
                    <span class="o_pro_kpi_label">Reclaimable Now</span>
                    <small><t t-esc="state.analytics.reclaimable"/> eligible attachment(s)</small>
                </button>
                <button class="o_pro_kpi_card o_pro_kpi_action o_pro_kpi_success"
                        type="button" t-on-click="onViewReclaimed">
                    <strong t-esc="state.analytics.reclaimed_display"/>
                    <span class="o_pro_kpi_label">Local Space Reclaimed</span>
                    <small><t t-esc="state.analytics.reclaimed"/> attachment(s)</small>
                </button>
                <button class="o_pro_kpi_card o_pro_kpi_action"
                        t-att-class="state.analytics.failed ? 'o_pro_kpi_danger' : ''"
                        type="button" t-on-click="onViewFailed">
                    <strong t-esc="state.analytics.failed"/>
                    <span class="o_pro_kpi_label">Failed Operations</span>
                    <small>Open failure queue</small>
                </button>
            </div>

            <section class="o_pro_section_intro" aria-labelledby="pro-controls-title">
                <div>
                    <h3 id="pro-controls-title">Pro safety controls</h3>
                    <p class="text-muted mb-0">These controls extend the migration workflow above; they never replace its verified-copy baseline.</p>
                </div>
            </section>

            <section class="o_pro_savings_panel" aria-labelledby="savings-title">
                <div class="o_pro_savings_intro">
                    <div>
                        <h3 id="savings-title">Estimated storage savings</h3>
                        <p class="text-muted mb-0">
                            Based on your configured local storage rate:
                            <strong t-esc="state.analytics.savings.cost_display"/>.
                        </p>
                    </div>
                    <i class="fa fa-line-chart" aria-hidden="true"/>
                </div>
                <div class="o_pro_savings_metrics">
                    <div>
                        <span>Already avoided / month</span>
                        <strong t-esc="state.analytics.savings.reclaimed_monthly_display"/>
                    </div>
                    <div>
                        <span>Additional eligible / month</span>
                        <strong t-esc="state.analytics.savings.reclaimable_monthly_display"/>
                    </div>
                    <div>
                        <span>Total potential / year</span>
                        <strong t-esc="state.analytics.savings.potential_annual_display"/>
                    </div>
                </div>
                <p class="o_pro_savings_note mb-0">
                    Estimate only. It excludes S3 charges, data transfer, taxes, and provider discounts.
                </p>
            </section>
            <section class="o_pro_assurance_panel" aria-labelledby="assurance-title">
                <div class="o_pro_assurance_header">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h3 id="assurance-title" class="mb-0">Recovery assurance</h3>
                            <span class="badge"
                                  t-att-class="state.analytics.recovery_assurance.status === 'healthy' ? 'text-bg-success' : state.analytics.recovery_assurance.status === 'failed' ? 'text-bg-danger' : 'text-bg-warning'"
                                  t-esc="state.analytics.recovery_assurance.status_label"/>
                        </div>
                        <p class="text-muted mb-0">
                            Latest immutable restore-drill evidence across allowed companies.
                        </p>
                    </div>
                    <button class="btn btn-outline-primary" type="button"
                            t-on-click="onViewRestoreDrills"
                            aria-label="Open restore drill evidence">
                        <i class="fa fa-external-link" aria-hidden="true"/>
                        View evidence
                    </button>
                </div>
                <div class="o_pro_assurance_metrics">
                    <div><span>Company coverage</span><strong t-esc="state.analytics.recovery_assurance.coverage_display"/></div>
                    <div><span>Latest sample</span><strong><t t-esc="state.analytics.recovery_assurance.passed"/> / <t t-esc="state.analytics.recovery_assurance.tested"/> passed</strong></div>
                    <div><span>Failed objects</span><strong t-esc="state.analytics.recovery_assurance.failed"/></div>
                    <div><span>Last completed</span><strong t-esc="state.analytics.recovery_assurance.last_run || 'Not run yet'"/></div>
                </div>
                <p class="o_pro_assurance_hint mb-0" t-if="state.analytics.recovery_assurance.status === 'disabled'">
                    Enable Scheduled Restore Drills in Settings to maintain continuous recovery evidence.
                </p>
                <p class="o_pro_assurance_hint mb-0" t-elif="state.analytics.recovery_assurance.status === 'overdue'">
                    One or more companies have no current evidence for the configured interval.
                </p>
                <p class="o_pro_assurance_hint o_pro_assurance_error mb-0" t-elif="state.analytics.recovery_assurance.status === 'failed'">
                    Review failed evidence before relying on automated cleanup.
                </p>
            </section>

            <div class="o_pro_dashboard_columns">
                <section class="o_pro_panel" aria-labelledby="readiness-title">
                    <div class="o_pro_panel_header">
                        <h3 id="readiness-title">Cleanup readiness</h3>
                        <span class="badge" t-att-class="state.readiness.ready ? 'text-bg-success' : 'text-bg-warning'"
                              t-esc="state.readiness.ready ? 'READY' : 'ATTENTION'"/>
                    </div>
                    <div class="o_pro_check_list">
                        <div class="o_pro_check" t-foreach="state.readiness.checks"
                             t-as="check" t-key="check.code">
                            <i t-att-class="'fa ' + (check.status === 'pass' ? 'fa-check-circle text-success' : check.status === 'warn' ? 'fa-exclamation-circle text-warning' : 'fa-times-circle text-danger')"/>
                            <div>
                                <strong t-esc="check.label"/>
                                <p class="mb-0 text-muted small" t-esc="check.detail"/>
                            </div>
                            <span class="visually-hidden" t-esc="check.status"/>
                        </div>
                    </div>
                </section>

                <section class="o_pro_panel" aria-labelledby="bucket-title">
                    <div class="o_pro_panel_header">
                        <h3 id="bucket-title">Verified storage by bucket</h3>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Bucket</th><th class="text-end">Objects</th><th class="text-end">Volume</th></tr></thead>
                            <tbody>
                                <tr t-foreach="state.analytics.buckets" t-as="bucket" t-key="bucket.bucket">
                                    <td><i class="fa fa-database text-muted me-1"/><t t-esc="bucket.bucket"/></td>
                                    <td class="text-end" t-esc="bucket.count"/>
                                    <td class="text-end" t-esc="bucket.display"/>
                                </tr>
                                <tr t-if="!state.analytics.buckets.length">
                                    <td colspan="3" class="text-center text-muted py-4">No finalized objects yet.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>
    </t>
</templates>
