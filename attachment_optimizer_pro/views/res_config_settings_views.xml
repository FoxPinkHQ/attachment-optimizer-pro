<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend the free edition settings app with Pro configuration.
         The free header stays untouched; all Pro settings are grouped
         into a single "Pro Features" block with clear sub-titles. -->
    <record id="attachment_optimizer_pro_res_config_settings" model="ir.ui.view">
        <field name="name">attachment.optimizer.pro.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="attachment_optimizer.view_attachment_optimizer_config_settings"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='attachment_optimizer']" position="attributes">
                <attribute name="data-string">Attachment Optimizer Pro</attribute>
                <attribute name="string">Attachment Optimizer Pro</attribute>
                <attribute name="logo">/attachment_optimizer_pro/static/description/icon.png</attribute>
            </xpath>
            <xpath expr="//app[@name='attachment_optimizer']" position="inside">
                <div id="pro_features">
                    <block title="Pro Features" name="pro_features_setting_container">

                        <setting type="header" string="Automatic Routing"/>
                        <setting id="pro_routing_enabled_setting" string="Enable Automatic Storage Routing"
                                 help="Route new attachments to a bucket profile automatically based on routing rules.">
                            <field name="pro_routing_enabled"/>
                            <div class="text-muted">
                                Configure routing rules under
                                Storage Optimization → Routing Rules.
                            </div>
                        </setting>

                        <setting type="header" string="Safe Local Cleanup"/>
                        <setting id="pro_cleanup_enabled_setting" string="Enable Safe Local Cleanup"
                                 help="Reclaim filestore space from verified mappings after the retention period.">
                            <field name="pro_cleanup_enabled"/>
                        </setting>
                        <setting id="pro_cleanup_retention_setting" string="Cleanup Retention (days)"
                                 help="Keep the local filestore copy this many days after migration before cleanup is allowed.">
                            <field name="pro_cleanup_retention_days"/>
                        </setting>
                        <setting id="pro_cleanup_quarantine_setting" string="Cleanup Quarantine (days)"
                                 help="After the local copy is removed, keep the mapping recoverable for this many days.">
                            <field name="pro_cleanup_quarantine_days"/>
                        </setting>

                        <setting type="header" string="Savings Estimate"/>
                        <setting id="pro_local_storage_cost_setting"
                                 string="Local Storage Cost (USD/GiB/month)"
                                 help="Your effective local or hosting storage cost. Used only for dashboard estimates; no billing data is collected.">
                            <field name="pro_local_storage_cost_per_gib"/>
                            <div class="text-muted">
                                Savings estimates equal reclaimed local GiB × this monthly rate.
                            </div>
                        </setting>
                        <setting type="header" string="Scheduled Restore Assurance"/>
                        <setting id="pro_restore_drill_enabled_setting"
                                 string="Enable Scheduled Restore Drills"
                                 help="Periodically download and verify a company-scoped sample without changing attachments or cleanup state.">
                            <field name="pro_restore_drill_enabled"/>
                        </setting>
                        <setting id="pro_restore_drill_sample_size_setting"
                                 string="Sample Size per Company"
                                 help="Number of eligible cleaned or quarantined objects verified for each company.">
                            <field name="pro_restore_drill_sample_size"/>
                        </setting>
                        <setting id="pro_restore_drill_interval_setting"
                                 string="Drill Interval (days)"
                                 help="Minimum number of days between scheduled restore-assurance runs.">
                            <field name="pro_restore_drill_interval_days"/>
                        </setting>

                        <setting type="header" string="Background Processing"/>
                        <setting id="pro_concurrency_setting" string="Routing Concurrency"
                                 help="Maximum routed operations processed per cron run.">
                            <field name="pro_concurrency"/>
                        </setting>

                        <setting type="header" string="Operational Alerts"/>
                        <setting id="pro_alert_enabled_setting" string="Enable Operational Alerts"
                                 help="Email alerts about failed queues, stuck operations and verification failures.">
                            <field name="pro_alert_enabled"/>
                        </setting>
                        <setting id="pro_alert_email_setting" string="Alert Recipient Email">
                            <field name="pro_alert_email" placeholder="admin@example.com"/>
                        </setting>

                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
