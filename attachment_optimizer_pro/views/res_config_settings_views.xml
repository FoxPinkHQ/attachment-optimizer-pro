<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="attachment_optimizer_pro_res_config_settings" model="ir.ui.view">
        <field name="name">attachment.optimizer.pro.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="attachment_optimizer.view_attachment_optimizer_config_settings"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='attachment_optimizer']" position="inside">
                <div id="pro_features">
                    <h2>Pro Features</h2>
                    <h3>Automatic Routing</h3>
                    <div class="row mt16 o_settings_container" name="pro_routing_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="pro_routing_enabled_setting"><div class="o_setting_left_pane"><field name="pro_routing_enabled"/></div><div class="o_setting_right_pane"><label for="pro_routing_enabled" string="Enable Automatic Storage Routing"/><div class="text-muted">Route new attachments to a bucket profile automatically based on routing rules. Configure routing rules under Storage Optimization → Routing Rules.</div></div></div>
                    </div>
                    <h3>Safe Local Cleanup</h3>
                    <div class="row mt16 o_settings_container" name="pro_cleanup_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="pro_cleanup_enabled_setting"><div class="o_setting_left_pane"><field name="pro_cleanup_enabled"/></div><div class="o_setting_right_pane"><label for="pro_cleanup_enabled" string="Enable Safe Local Cleanup"/><div class="text-muted">Reclaim filestore space from verified mappings after the retention period.</div></div></div>
                        <div class="col-12 col-lg-6 o_setting_box" id="pro_cleanup_retention_setting"><div class="o_setting_right_pane"><label for="pro_cleanup_retention_days" string="Cleanup Retention (days)"/><div class="text-muted">Keep the local filestore copy this many days after migration before cleanup is allowed.</div><field name="pro_cleanup_retention_days"/></div></div>
                        <div class="col-12 col-lg-6 o_setting_box" id="pro_cleanup_quarantine_setting"><div class="o_setting_right_pane"><label for="pro_cleanup_quarantine_days" string="Cleanup Quarantine (days)"/><div class="text-muted">After the local copy is removed, keep the mapping recoverable for this many days.</div><field name="pro_cleanup_quarantine_days"/></div></div>
                    </div>
                    <h3>Savings Estimate</h3>
                    <div class="row mt16 o_settings_container" name="pro_savings_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="pro_local_storage_cost_setting"><div class="o_setting_right_pane">
                            <label for="pro_local_storage_cost_per_gib" string="Local Storage Cost (USD/GiB/month)"/>
                            <div class="text-muted">Used only for dashboard estimates. Savings equal reclaimed local GiB multiplied by this monthly rate.</div>
                            <field name="pro_local_storage_cost_per_gib"/>
                        </div></div>
                    </div>                    <h3>Background Processing</h3>
                    <div class="row mt16 o_settings_container" name="pro_background_setting_container"><div class="col-12 col-lg-6 o_setting_box" id="pro_concurrency_setting"><div class="o_setting_right_pane"><label for="pro_concurrency" string="Routing Concurrency"/><div class="text-muted">Maximum routed operations processed per cron run.</div><field name="pro_concurrency"/></div></div></div>
                    <h3>Operational Alerts</h3>
                    <div class="row mt16 o_settings_container" name="pro_alert_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="pro_alert_enabled_setting"><div class="o_setting_left_pane"><field name="pro_alert_enabled"/></div><div class="o_setting_right_pane"><label for="pro_alert_enabled" string="Enable Operational Alerts"/><div class="text-muted">Email alerts about failed queues, stuck operations and verification failures.</div></div></div>
                        <div class="col-12 col-lg-6 o_setting_box" id="pro_alert_email_setting"><div class="o_setting_right_pane"><label for="pro_alert_email" string="Alert Recipient Email"/><field name="pro_alert_email" placeholder="admin@example.com"/></div></div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@data-key='attachment_optimizer']" position="attributes">
                <attribute name="data-string">Attachment Optimizer Pro</attribute>
                <attribute name="string">Attachment Optimizer Pro</attribute>
                <attribute name="data-key">attachment_optimizer_pro</attribute>
            </xpath>        </field>
    </record>
    <record id="attachment_optimizer.attachment_optimizer_settings_action" model="ir.actions.act_window">
        <field name="context">{'module': 'attachment_optimizer_pro'}</field>
    </record></odoo>
