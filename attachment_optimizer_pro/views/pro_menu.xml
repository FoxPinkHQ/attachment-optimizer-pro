<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- All Pro menus are grouped under a single "Pro Features" submenu so
         the free edition menu header stays untouched. -->
    <menuitem id="attachment_optimizer_pro_menu"
              name="Pro Features"
              parent="attachment_optimizer.storage_optimization_menu"
              groups="attachment_optimizer.group_storage_optimization_manager"
              sequence="20"/>

    <menuitem id="attachment_optimizer_pro_storage_bucket_menu"
              name="Buckets"
              parent="attachment_optimizer_pro_menu"
              action="attachment_optimizer_pro_storage_bucket_action"
              groups="attachment_optimizer.group_storage_optimization_manager"
              sequence="10"/>

    <menuitem id="attachment_optimizer_pro_storage_rule_menu"
              name="Routing Rules"
              parent="attachment_optimizer_pro_menu"
              action="attachment_optimizer_pro_storage_rule_action"
              groups="attachment_optimizer.group_storage_optimization_manager"
              sequence="20"/>

    <menuitem id="attachment_optimizer_pro_storage_policy_menu"
              name="Lifecycle Policies"
              parent="attachment_optimizer_pro_menu"
              action="attachment_optimizer_pro_storage_policy_action"
              groups="attachment_optimizer.group_storage_optimization_manager"
              sequence="30"/>

    <menuitem id="attachment_optimizer_pro_cleanup_batch_menu"
              name="Cleanup Batches"
              parent="attachment_optimizer_pro_menu"
              action="attachment_optimizer_pro_cleanup_batch_action"
              groups="attachment_optimizer.group_storage_optimization_manager"
              sequence="40"/>

    <menuitem id="attachment_optimizer_pro_restore_batch_menu"
              name="Restore Batches"
              parent="attachment_optimizer_pro_menu"
              action="attachment_optimizer_pro_restore_batch_action"
              groups="attachment_optimizer.group_storage_optimization_manager"
              sequence="50"/>

    <menuitem id="attachment_optimizer_pro_restore_drill_menu"
              name="Restore Drills"
              parent="attachment_optimizer_pro_menu"
              action="attachment_optimizer_pro_restore_drill_action"
              groups="attachment_optimizer.group_storage_optimization_manager"
              sequence="55"/>
    <!-- Analytics report action (bound to the Storage Optimization menu) -->
    <record id="attachment_optimizer_pro_analytics_action" model="ir.actions.server">
        <field name="name">Storage Analytics (Pro)</field>
        <field name="model_id" ref="model_attachment_storage_mapping"/>
        <field name="state">code</field>
        <field name="code">
action = env['attachment.storage.mapping'].action_show_analytics()
</field>
    </record>

    <record id="attachment_optimizer_pro_safety_dashboard_action" model="ir.actions.client">
        <field name="name">Safety &amp; Savings</field>
        <field name="tag">attachment_optimizer_pro.safety_dashboard</field>
    </record>

    <menuitem id="attachment_optimizer_pro_analytics_menu"
              name="Safety &amp; Savings"
              parent="attachment_optimizer_pro_menu"
              action="attachment_optimizer_pro_safety_dashboard_action"
              groups="attachment_optimizer.group_storage_optimization_manager"
              sequence="60"/>
</odoo>
