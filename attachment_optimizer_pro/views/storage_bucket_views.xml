<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── List View ─────────────────────────────────────── -->
    <record id="attachment_optimizer_pro_storage_bucket_tree" model="ir.ui.view">
        <field name="name">attachment.storage.bucket.tree</field>
        <field name="model">attachment.storage.bucket</field>
        <field name="arch" type="xml">
            <list create="true" import="false" export_xlsx="false">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="provider"/>
                <field name="region"/>
                <field name="endpoint_url" optional="show"/>
                <field name="is_default"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────── -->
    <record id="attachment_optimizer_pro_storage_bucket_form" model="ir.ui.view">
        <field name="name">attachment.storage.bucket.form</field>
        <field name="model">attachment.storage.bucket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" string="Test Connection"
                            type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="my-bucket"/>
                            <field name="provider"/>
                            <field name="sequence"/>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="region" placeholder="us-east-1"/>
                            <field name="endpoint_url"
                                   placeholder="https://s3.example.com"/>
                            <field name="sse"/>
                            <field name="company_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Credentials">
                        <field name="access_key_id"/>
                        <field name="secret_access_key" password="true"/>
                        <div class="text-muted">
                            Test the connection before use. Credentials are
                            restricted to Storage Optimization Managers and
                            never appear in audit logs. Leave them blank to
                            use the runtime IAM role or credential provider.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search View ───────────────────────────────────── -->
    <record id="attachment_optimizer_pro_storage_bucket_search" model="ir.ui.view">
        <field name="name">attachment.storage.bucket.search</field>
        <field name="model">attachment.storage.bucket</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="provider"/>
                <field name="endpoint_url"/>
                <filter name="default" string="Default"
                        domain="[('is_default', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────── -->
    <record id="attachment_optimizer_pro_storage_bucket_action" model="ir.actions.act_window">
        <field name="name">Buckets</field>
        <field name="res_model">attachment.storage.bucket</field>
        <field name="view_mode">list,form</field>
        <field name="help">
            Configure S3-compatible bucket profiles for multi-bucket routing.
        </field>
    </record>
</odoo>
