<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_storage_bucket_company" model="ir.rule">
            <field name="name">Storage Bucket: multi-company isolation</field>
            <field name="model_id" ref="model_attachment_storage_bucket"/>
            <field name="domain_force">['|', ('company_ids', '=', False), ('company_ids', 'in', company_ids)]</field>
        </record>

        <record id="rule_storage_rule_company" model="ir.rule">
            <field name="name">Storage Rule: multi-company isolation</field>
            <field name="model_id" ref="model_attachment_storage_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_storage_policy_company" model="ir.rule">
            <field name="name">Storage Policy: multi-company isolation</field>
            <field name="model_id" ref="model_attachment_storage_policy"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cleanup_batch_company" model="ir.rule">
            <field name="name">Cleanup Batch: multi-company isolation</field>
            <field name="model_id" ref="model_attachment_cleanup_batch"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_restore_batch_company" model="ir.rule">
            <field name="name">Restore Batch: multi-company isolation</field>
            <field name="model_id" ref="model_attachment_restore_batch"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
